{
  "name": "@rouge-one/api",
  "version": "0.1.0",
  "description": "",
  "main": "build/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "prisma generate && tsc",
    "start": "node build/app.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "db:generate": "node ../../scripts/prisma.mjs generate",
    "db:migrate": "node ../../scripts/prisma.mjs migrate deploy",
    "db:dev": "node ../../scripts/prisma.mjs migrate dev",
    "db:preflight": "tsx src/database/preflight.ts"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@prisma/client": "5.12.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.12.1",
    "fastify": "5.12.5",
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/cors": "11.3.1",
    "nodemailer": "10.1.0",
    "@rouge-one/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "pino-pretty": "^11.0.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "@types/nodemailer": "8.0.2"
  },
  "private": true,
  "files": [
    "build",
    "prisma"
  ]
}

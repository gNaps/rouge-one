{
  "name": "rouge-one",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.21.1 <23"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @rouge-one/api test",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @rouge-one/api db:migrate",
    "db:preflight": "pnpm --filter @rouge-one/api db:preflight",
    "backup": "node scripts/database.mjs backup",
    "restore": "node scripts/database.mjs restore",
    "licenses": "node scripts/licenses.mjs",
    "release:check": "node scripts/release-preflight.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  },
  "pnpm": {
    "overrides": {
      "jws@^3.2.2": "3.2.3"
    }
  }
}

POSTGRES_DB=rouge_one
POSTGRES_PASSWORD=GENERATED_PASSWORD
ADMIN_JWT_SECRET=GENERATED_SECRET
PEOPLE_JWT_SECRET=GENERATED_DISTINCT_SECRET
BOOTSTRAP_TOKEN=GENERATED_SETUP_TOKEN

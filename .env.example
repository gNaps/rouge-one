# Run pnpm run setup to create .env.local without changing a pre-existing .env.
PUBLIC_URL=http://localhost:8080
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=false
DATABASE_URL=postgresql://rouge:GENERATED_PASSWORD@localhost:5433/rouge_one
